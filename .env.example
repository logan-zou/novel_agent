# 必填：服务需支持流式 Chat Completions、tool calling 和 usage 返回
# 按实际模型调整下面的容量参数；兼容协议不代表相同的抽取效果
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-api-key

# 可以只设置一个公共模型，也可以为知识抽取和问答分别指定
LLM_MODEL=replace-with-your-model
# EXTRACTION_MODEL=replace-with-your-extraction-model
# QA_MODEL=replace-with-your-qa-model

# 仅当所用兼容服务明确支持时开启
LLM_INCLUDE_REASONING_EFFORT=false
LLM_ENABLE_THINKING=false
EXTRACTION_REASONING_EFFORT=low
QA_REASONING_EFFORT=high

# 流式读取超时或连接中断后额外重试次数；0 关闭，默认 5（等待 2、4、8、16、30 秒）
LLM_STREAM_MAX_RETRIES=5

# 可选模型容量参数，请按实际模型调整
MODEL_CONTEXT_TOKENS=200000
MODEL_MAX_OUTPUT_TOKENS=16384
MODEL_TEMPERATURE=0.5

# 可选：知识库输出目录
# KNOWLEDGE_BASE_DIR=./knowledge_base

# 可选：安装 observability 依赖后启用 Langfuse
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
